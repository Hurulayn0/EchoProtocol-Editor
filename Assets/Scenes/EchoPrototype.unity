  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0130lk g\xFCvenlik kilidini a\u015Ft\u0131n ama tesisin savunma a\u011F\u0131
    varl\u0131\u011F\u0131n\u0131 tespit etti. Bak\u0131m Hatt\u0131'na devriye gezen
    z\u0131rhl\u0131 bir Muhaf\u0131z robotu indirildi; bu makineler canl\u0131 insan\u0131
    de\u011Fil, g\xF6rd\xFCkleri ilk hareket izini hedef al\u0131yor.\n\nKendi Echo'nu
    yem olarak kullan, siperlerin arkas\u0131nda [C] ile e\u011Filerek ilerle ya
    da odadaki EMP Jenerat\xF6r\xFCn\xFC vurup muhaf\u0131z\u0131 fel\xE7 ederek
    hem ge\xE7i\u015F yolunu hem de Veri Kasas\u0131'n\u0131 a\xE7."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
