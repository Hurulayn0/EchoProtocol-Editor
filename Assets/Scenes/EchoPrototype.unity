--- !u!1 &727198062
GameObject:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  serializedVersion: 6
  m_Component:
  - component: {fileID: 727198065}
  - component: {fileID: 727198064}
  - component: {fileID: 727198063}
  m_Layer: 0
  m_Name: "Y\u0131l 2089. Yeralt\u0131ndaki Kronos Ara\u015Ft\u0131rma Tesisi'nde
    y\xFCr\xFCt\xFClen 'Echo Protokol\xFC' zaman deneyi kontrolden \xE7\u0131kt\u0131.
    Tesisin g\xFCvenlik yapay zek\xE2s\u0131 t\xFCm \xE7\u0131k\u0131\u015Flar\u0131
    m\xFCh\xFCrledi ve muhaf\u0131z robotlar\u0131 i\xE7erideki herkesi karantinada
    tutmak \xFCzere silahland\u0131rd\u0131."
  m_TagString: Untagged
  m_Icon: {fileID: 0}
  m_NavMeshLayer: 0
  m_StaticEditorFlags: 0
  m_IsActive: 1
--- !u!114 &727198063
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 727198062}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Y\u0131l 2089. Yeralt\u0131ndaki Kronos Ara\u015Ft\u0131rma Tesisi'nde
    y\xFCr\xFCt\xFClen 'Echo Protokol\xFC' zaman deneyi kontrolden \xE7\u0131kt\u0131.
    Tesisin g\xFCvenlik yapay zek\xE2s\u0131 t\xFCm \xE7\u0131k\u0131\u015Flar\u0131
    m\xFCh\xFCrledi ve muhaf\u0131z robotlar\u0131 i\xE7erideki herkesi karantinada
    tutmak \xFCzere silahland\u0131rd\u0131.\n\nSen, ekipten sa\u011F kurtulan son
    sistem operat\xF6r\xFCs\xFCn. Bile\u011Findeki deneysel Zaman Kay\u0131t Cihaz\u0131,
    hareketlerini ve eylemlerini bir 'Echo' (zaman yans\u0131mas\u0131) olarak kaydedip
    bir sonraki d\xF6ng\xFCde seninle yan yana \xE7al\u0131\u015Ft\u0131rabiliyor.
    Tek ki\u015Fiyle a\xE7\u0131lamayan \xE7ift g\xFCvenlik kilitlerini a\u015Fman\u0131n
    tek yolu, kendi ge\xE7mi\u015Finle ekip olmak.\n\n\xD6n\xFCndeki Ara\u015Ft\u0131rma
    Lab\u0131 ilk test odas\u0131 ve hen\xFCz muhaf\u0131z inmi\u015F de\u011Fil.
    Turuncu konsolu [E] ile a\xE7, mavi plakada bekle, [R] ile Echo'nu kaydet ve
    \xE7\u0131k\u0131\u015F kap\u0131s\u0131ndan ge\xE7erek tesisin derinliklerine
    ilerle. \u0130stersen parlayan EMP K\xFCresini vurup Veri Kasas\u0131'n\u0131
    hackleyerek kal\u0131c\u0131 silah g\xFC\xE7lendirmesi de kazanabilirsin."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
