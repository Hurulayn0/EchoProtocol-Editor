  - component: {fileID: 1047659527}
  - component: {fileID: 1047659526}
  - component: {fileID: 1047659525}
  m_Layer: 0
  m_Name: "\u0130lk g\xFCvenlik kilidini a\u015Ft\u0131n ama tesisin savunma a\u011F\u0131
    varl\u0131\u011F\u0131n\u0131 tespit etti. Bak\u0131m Hatt\u0131'na devriye gezen
    z\u0131rhl\u0131 bir Muhaf\u0131z robotu indirildi; bu makineler canl\u0131 insan\u0131
    de\u011Fil, g\xF6rd\xFCkleri ilk hareket izini hedef al\u0131yor."
  m_TagString: Untagged
  m_Icon: {fileID: 0}
  m_NavMeshLayer: 0
  m_StaticEditorFlags: 0
  m_IsActive: 1
--- !u!114 &1047659525
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
